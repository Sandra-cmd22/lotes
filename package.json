{
  "name": "lotes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check-backup": "node scripts/check-backup.mjs",
    "export-dados": "npx tsx scripts/export-app-data.ts",
    "supabase:schema": "npx tsx --env-file=.env scripts/apply-supabase-schema.ts",
    "supabase:seed": "npx tsx --env-file=.env scripts/push-supabase-seed.ts",
    "supabase:setup": "npm run supabase:schema && npm run supabase:seed",
    "apply-planilha": "npx tsx scripts/apply-partial-table.ts --write && npm run supabase:seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
