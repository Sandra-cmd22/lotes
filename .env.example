# Copie para .env — Settings → API: Project URL + chave publishable (ou anon public)
# Nunca coloque sb_secret / service_role aqui (só roda no navegador).

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_publishable_ou_anon

# Opcional — criar tabela pelo terminal (Database → senha do Postgres). Não commitar.
# SUPABASE_DB_PASSWORD=
